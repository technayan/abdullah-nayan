# Copy this file to .env.local and fill in the values (never commit .env.local).

# 1) Create a free account at https://resend.com, then make an API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 2) The inbox that should receive the contact messages.
#    Until you verify your own domain in Resend, this must be the same email
#    you used to sign up for Resend.
CONTACT_TO_EMAIL=your.email@example.com

# 3) Optional. Leave unset to use Resend's test sender (onboarding@resend.dev).
#    After verifying a domain you can use e.g. contact@your-domain.com
# CONTACT_FROM_EMAIL=contact@your-domain.com
